<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\StatusHub.Contracts\StatusHub.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms implicit usings clash with WPF names (Application, MessageBox, Image...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in character packages: characters/<id>/ next to the executable. -->
    <None Include="..\..\assets\runtime\**\*" LinkBase="characters\claude-girl" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="BuiltInCharacters\**" />
    <None Include="BuiltInCharacters\**\*" LinkBase="characters" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
